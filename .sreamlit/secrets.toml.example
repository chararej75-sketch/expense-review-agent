# Copy this file to .streamlit/secrets.toml for LOCAL use only.
# Never commit the real secrets.toml file to GitHub (it is already in .gitignore).
#
# On Streamlit Community Cloud: go to your app -> Settings -> Secrets, and
# paste the same key/value pairs there instead of committing this file.
#
# This key is OPTIONAL. The agent works fully without it (rule-based +
# Isolation Forest scoring, template narrative summary). It only enables
# the optional "Use Claude AI for narrative summary" toggle in the app.

ANTHROPIC_API_KEY = "sk-ant-your-own-key-here"
